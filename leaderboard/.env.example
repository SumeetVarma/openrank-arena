# Vercel KV (Redis-style key-value)
# Provision via Vercel dashboard → Storage → KV. These env vars are auto-injected on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# Vercel Blob (zip + asset storage)
# Provision via Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# Shared password used by /api/feedback (and optionally elsewhere)
ARENA_SHARED_PASSWORD=WANNABE_FOUNDERS

# Base URL the harness fetches candidates from when running judge runs.
# In production: https://openrank-arena.vercel.app
# In local dev: http://localhost:3000
ARENA_BASE_URL=http://localhost:3000

# Judge model provider (anthropic | openai)
JUDGE_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
